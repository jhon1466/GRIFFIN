{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=griffin;Username=postgres;Password=password"
  },
  "GameServer": {
    "Host": "127.0.0.1",
    "Port": 7001
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "https://127.0.0.1:443"
      },

      "Https": {
        "Url": "https://127.0.0.1:80"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/griffin-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 5,
          "shared": true,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
