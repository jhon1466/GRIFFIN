"64002": {
"en": "MH3? This name i-is just...!",
"es": "¿MH3? ¡Este nombre e-es simplemente...!"
},
"64003": {
"en": "Thief! Take em out!",
"es": "¡Ladrón! ¡Eliminarlos!"
},
