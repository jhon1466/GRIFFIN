"64005": {
"en": "Springfield Gacha 10-Pull Ticket Event (Pending Packaging)",
"es": "Evento de cupón de 10 tiradas de gacha de Springfield (pendiente de empaquetado)"
},
"64006": {
"en": "Of course, and we're not going to lose to them!|Commander, Helena! Time to become even better!",
"es": "Por supuesto, ¡y no vamos a perder contra ellos!|¡Comandante, Helena! ¡Es hora de ser aún mejores!"
},
"64007": {
"en": "Even better? I feel like I'm pretty much at my limit...",
"es": "¿Aún mejores? Siento que ya estoy en mi límite..."
},
"64008": {
"en": "New clothes! Better than them, better looking!",
"es": "¡Ropa nueva! ¡Mejor que ellos, mejor aspecto!"
},
